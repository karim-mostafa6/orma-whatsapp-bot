# انسخ الملف ده لـ .env وعدّل اللي محتاجه. كل القيم دي اختيارية وليها قيم افتراضية.

# ---- التأخير والـ typing ----
# البوت بيستنى رقم عشوائي بين الاتنين دول (بالمللي ثانية) وهو بيظهر "typing..."
MIN_DELAY_MS=2000
MAX_DELAY_MS=4000
# يعلّم رسالة العميل "مقروءة" (علامتين زرق) قبل ما يرد
MARK_AS_READ=true

# ---- التحويل لموظف ----
# البوت يفضل ساكت كام ساعة بعد ما العميل يطلب موظف (0 = لحد ما تكتب #bot)
HANDOFF_HOURS=12
# لو إنت رديت بنفسك في محادثة، البوت يسكت فيها كام ساعة (0 = البوت يكمّل يرد عادي)
OWNER_REPLY_PAUSE_HOURS=12
# بعد كام رسالة متتالية البوت ما فهمهاش يحوّل لموظف (0 = ما يحوّلش أبداً)
UNMATCHED_BEFORE_HANDOFF=2
# يبعتلك إشعار في محادثتك مع نفسك ("Message yourself") لما عميل يتحوّل لموظف
NOTIFY_OWNER=true
# يمسح أوامر #bot و #stop من المحادثة بعد ما يتنفذوا (العميل هيشوف "تم حذف الرسالة")
DELETE_OWNER_COMMANDS=true

# ---- الحماية من السبام ----
# أقصى عدد ردود لنفس العميل في الدقيقة
MAX_REPLIES_PER_MINUTE=4
# ما يردش على رسايل أقدم من كده بالدقايق (مثلاً لو البوت كان مقفول)
MAX_MESSAGE_AGE_MINUTES=60

# ---- طريقة الرد ----
# keyword = كلمات مفتاحية من faq.json بس (مجاني 100%)
# hybrid  = كلمات مفتاحية، ولو ما لقتش رد يسأل LLM (محتاج الـ 3 اللي تحت)
RESPONDER=keyword
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- مسارات (سيبها زي ما هي غالباً) ----
AUTH_DIR=auth
FAQ_FILE=data/faq.json
STATE_FILE=data/state.json

# debug / info / warn / error
LOG_LEVEL=info
